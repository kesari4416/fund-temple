      "Card": {
        "padding": 24,
        "colorBorderSecondary": "#E2D9CC"
      },
      "Input": {
        "colorBorder": "#CBD5E1",
        "hoverBorderColor": "#800000",
        "activeBorderColor": "#800000"
      },
      "Select": {
        "colorBorder": "#CBD5E1"
      }
    }
  },
  "login_page_redesign": {
    "layout": "Split Screen or Elevated Glassmorphic Center Card",
    "background_image": "https://images.unsplash.com/photo-1554554497-0095c34db3ec?crop=entropy&cs=srgb&fm=jpg&q=85",
    "overlay": "linear-gradient(135deg, rgba(42, 4, 7, 0.88) 0%, rgba(30, 2, 5, 0.94) 100%)",
    "card": {
      "background": "#FFFFFF",
      "border": "1px solid rgba(197, 160, 89, 0.4)",
      "border_radius": "16px",
      "box_shadow": "0 20px 40px rgba(0, 0, 0, 0.25)",
      "padding": "40px"
    },
    "branding": {
      "title": "TEMPLE TRUST FINANCIAL PORTAL",
      "subtitle": "Internal Financial & Administration System",
      "badge": "OFFICIAL TRUSTEE ACCESS"
    }
