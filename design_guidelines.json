{
  "project_title": "Temple Management System - GUI Redesign & Architectural Guidelines",
  "app_type": "dashboard / saas_app (Internal Financial & Administrative System for Hindu Temple Trust)",
  "design_archetype": "Organic & Earthy meets High-Precision Swiss Financial Dashboard (Kumkum Crimson, Antique Gold, Warm Linen Parchment, Obsidian Charcoal)",
