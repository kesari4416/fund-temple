    "font_family_mono": "IBM Plex Mono, JetBrains Mono, monospace",
    "scale": {
      "h1": "font-size: 28px; line-height: 36px; font-weight: 700; letter-spacing: -0.02em;",
      "h2": "font-size: 22px; line-height: 28px; font-weight: 700; letter-spacing: -0.01em;",
      "h3": "font-size: 18px; line-height: 24px; font-weight: 600;",
      "body_large": "font-size: 15px; line-height: 22px; font-weight: 400;",
      "body_default": "font-size: 14px; line-height: 20px; font-weight: 400;",
      "small_label": "font-size: 12px; line-height: 16px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;"
    }
  },
  "layout_architecture": {
    "sidebar": {
      "width_expanded": "280px",
      "width_collapsed": "80px",
      "background": "#2A0407",
      "brand_header": {
        "height": "70px",
        "background": "#1E0205",
        "border_bottom": "1px solid rgba(197, 160, 89, 0.25)"
      },
      "active_item": {
        "background": "linear-gradient(90deg, rgba(197, 160, 89, 0.2) 0%, rgba(128, 0, 0, 0.4) 100%)",
        "color": "#FFFFFF",
        "border_left": "4px solid #C5A059"
      },
      "hover_item": {
        "background": "rgba(255, 255, 255, 0.06)",
        "color": "#F1F5F9"
      }
    },
    "top_header": {
      "height": "70px",
      "background": "rgba(255, 255, 255, 0.9)",
      "backdrop_filter": "blur(12px)",
      "border_bottom": "1px solid #E2D9CC",
      "shadow": "0 2px 10px rgba(0, 0, 0, 0.03)"
    },
    "content_area": {
      "background": "#FAF8F5",
      "padding": "24px 32px",
      "max_width": "1600px",
      "card_style": {
        "background": "#FFFFFF",
        "border": "1px solid #E2D9CC",
        "border_radius": "10px",
        "box_shadow": "0 4px 20px rgba(0, 0, 0, 0.03)",
        "padding": "24px"
      }
    }
  },
