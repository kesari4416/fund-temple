  "key_files_to_update": [
    "/app/frontend/src/theme/index.js",
    "/app/frontend/src/layout/DashboardLayout.jsx",
    "/app/frontend/src/layout/Partials/Style.js",
    "/app/frontend/src/layout/Partials/SideMenu.jsx",
    "/app/frontend/src/layout/Partials/DynamicSubmenu/NavHeader.jsx",
    "/app/frontend/src/modules/Auth/Login/Login.jsx"
  ],
  "image_urls": {
    "login_hero_bg": "https://images.unsplash.com/photo-1554554497-0095c34db3ec?crop=entropy&cs=srgb&fm=jpg&q=85",
    "temple_architecture": "https://images.unsplash.com/photo-1677434654722-69e7ba88b4ef?crop=entropy&cs=srgb&fm=jpg&q=85",
    "heritage_structure": "https://images.unsplash.com/photo-1529733772151-bab41484710a?crop=entropy&cs=srgb&fm=jpg&q=85"
  },
  "data_testid_convention": {
    "rule": "Every interactive button, input, menu item, table row action, modal trigger, and key stat metric MUST have data-testid in kebab-case.",
    "examples": {
      "login_email": "login-email-input",
      "login_submit": "login-submit-button",
      "sidebar_item": "sidebar-menu-item-{moduleName}",
      "header_logout": "header-logout-button",
      "dashboard_stat_card": "dashboard-stat-card-{metricKey}",
      "table_search": "table-search-input",
      "table_action_edit": "table-action-edit-button"
    }
  },
  "UNIVERSAL_GUIDELINES_FOR_MAIN_AGENT": [
    "Maintain 100% existing module functionality - update only layout, styling, theme tokens, and component wrappers.",
    "Use AntD ConfigProvider with the specified custom theme tokens at the app root level.",
    "Ensure high contrast for non-technical temple admin staff (all body text meets WCAG AA 4.5:1 minimum).",
    "Format tabular numbers in ledger/financial tables with font-feature-settings: 'tnum' or monospace alignment.",
    "Never use raw transparent backgrounds on headers or dropdowns that float over content.",
    "Add data-testid attributes to all interactive elements."
  ]
}