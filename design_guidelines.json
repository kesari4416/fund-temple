      "card_surface": "#FFFFFF",
      "sidebar_dark": "#2A0407",
      "sidebar_header": "#1E0205",
      "table_zebra": "#F7F4EF",
      "table_header": "#EFEAE1"
    },
    "text": {
      "heading": "#1E293B",
