      "colorBgBase": "#FFFFFF",
      "colorBgLayout": "#FAF8F5",
      "colorBgContainer": "#FFFFFF",
      "colorBorder": "#E2D9CC",
      "colorBorderSecondary": "#EFE8DC",
      "borderRadius": 8,
      "fontFamily": "Plus Jakarta Sans, sans-serif",
      "fontSize": 14,
      "controlHeight": 38,
      "boxShadowSecondary": "0 4px 12px rgba(0,0,0,0.05)"
