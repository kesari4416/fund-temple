# ==== Django ====
DJANGO_SETTINGS_MODULE=temple_proj.settings.settings
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_MIN_50_CHARS
DEBUG=True
ALLOWED_HOSTS=temple.example.com,www.temple.example.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://temple.example.com,https://www.temple.example.com
# ==== MySQL (MariaDB) ====
DB_NAME=temple
DB_HOST=localhost
DB_PORT=3306
DB_USER=appadmin
DB_PASSWORD=appadmin
# ==== Media / Static ====
MEDIA_URL=/api/media/
STATIC_URL=/static/
